# Supabase Configuration
VITE_SUPABASE_URL=https://xcwgethymuvxcalxukzy.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Supabase Service Role Key (for admin operations, keep private)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── VIVA Virtual Try-On (Gemini) ──────────────────────────────────────────
# The Gemini API key is NOT a client/browser variable. It lives ONLY as a
# Supabase Edge Function secret so it never ships in the frontend bundle.
# Get a key from Google AI Studio (https://aistudio.google.com/apikey), then:
#   supabase secrets set GEMINI_API_KEY=your_key_here
#   supabase functions deploy virtual-tryon
# Optional model override (defaults to gemini-2.5-flash-image / "Nano Banana"):
#   supabase secrets set GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── VIVA checkout (Paystack) ──────────────────────────────────────────────
# PUBLIC key only. This one is designed to ship in the browser bundle.
#   Test:  pk_test_...      Live:  pk_live_...
# Get it from https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
#
# The SECRET key (sk_live_... / sk_test_...) must NEVER appear here, in .env,
# or anywhere in this repo — it can move money. It lives only as a Supabase
# Edge Function secret, read by verify-payment:
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_live_your_secret_key
#   supabase functions deploy create-order
#   supabase functions deploy verify-payment
#
# Checkout is disabled and says so in the UI until VITE_PAYSTACK_PUBLIC_KEY
# is set, rather than failing at the payment window.
